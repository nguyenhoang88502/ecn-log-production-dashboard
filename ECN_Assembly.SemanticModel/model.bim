        "partitions": [
          {
            "name": "ECN Weeks",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"ECN Weeks Base\",",
                "    Pick =",
                "        Table.SelectColumns(",
                "            Source,",
                "            {\"Line No\", \"ECN Number\", \"Old item\", \"New item\", \"Change\", \"Week No\", \"Week Start\",",
                "             \"Week Label\", \"Week Key\", \"Week Rel\", \"Rel Order\", \"Rel N\", \"Balance\", \"Begin\",",
                "             \"Demand\", \"Old Used\", \"New Used\", \"Mode\"}",
                "        ),",
                "    Typed =",
                "        Table.TransformColumnTypes(",
                "            Pick,",
                "            {",
                "                {\"Line No\", Int64.Type}, {\"ECN Number\", type text}, {\"Old item\", type text},",
                "                {\"New item\", type text}, {\"Change\", type text}, {\"Week No\", Int64.Type},",
                "                {\"Week Start\", type date}, {\"Week Label\", type text}, {\"Week Key\", Int64.Type},",
                "                {\"Week Rel\", type text}, {\"Rel Order\", Int64.Type}, {\"Rel N\", Int64.Type},",
                "                {\"Balance\", type number}, {\"Begin\", type number}, {\"Demand\", type number},",
                "                {\"Old Used\", type number}, {\"New Used\", type number}, {\"Mode\", type text}",
                "            }",
                "        )",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "measures": [
          {
            "name": "SL nhu cầu",
            "expression": [
              "SUMX (",
              "    SUMMARIZE ( 'ECN Weeks', 'ECN Weeks'[Old item], 'ECN Weeks'[Week Start] ),",
              "    CALCULATE ( MAX ( 'ECN Weeks'[Demand] ) )",
              ")"
            ],
            "lineageTag": "8b895f7b-c711-4075-825c-b436714a422b",
            "description": "Old-item quantity used in the week. The same old item in several ECN lines is counted once.",
            "formatString": "#,0"
          },
          {
            "name": "SL dùng mã cũ",
            "expression": [
              "SUMX (",
              "    SUMMARIZE ( 'ECN Weeks', 'ECN Weeks'[Old item], 'ECN Weeks'[Week Start] ),",
              "    CALCULATE ( MAX ( 'ECN Weeks'[Old Used] ) )",
              ")"
            ],
            "lineageTag": "1a9ca502-323a-4909-a5a5-f3f7ffe63b9f",
            "description": "Part of the usage still covered by old-item stock.",
            "formatString": "#,0"
          },
          {
            "name": "SL mã mới / thiếu",
            "expression": [
              "SUMX (",
              "    SUMMARIZE ( 'ECN Weeks', 'ECN Weeks'[Old item], 'ECN Weeks'[Week Start] ),",
              "    CALCULATE ( MAX ( 'ECN Weeks'[New Used] ) )",
              ")"
            ],
            "lineageTag": "2c072783-a571-497c-b0e8-51afafbb00c1",
            "description": "Part of the usage beyond old-item stock: runs on the new item (or is short if there is none).",
            "formatString": "#,0"
          },
          {
            "name": "ECN có nhu cầu",
            "expression": [
              "CALCULATE ( DISTINCTCOUNT ( 'ECN Weeks'[ECN Number] ), 'ECN Weeks'[Demand] > 0 ) + 0"
            ],
            "lineageTag": "089ff603-a2a7-43f3-a353-5d62e4d1be79",
            "description": "ECNs whose old item is used in the selected week(s).",
            "formatString": "#,0"
          },
          {
            "name": "SL tuần (pcs)",
            "expression": [
              "VAR x = [SL nhu cầu]",
              "RETURN IF ( x > 0, x )"
            ],
            "lineageTag": "35163ec5-846c-4cb5-a0fb-c81c287d0b61",
            "description": "Blank when 0 so cards only show lines that run.",
            "formatString": "#,0"
          },
          {
            "name": "Tồn mã cũ cuối tuần",
            "expression": [
              "IF (",
              "    [SL nhu cầu] > 0,",
              "    SUMX (",
              "        SUMMARIZE ( 'ECN Weeks', 'ECN Weeks'[Old item], 'ECN Weeks'[Week Start] ),",
              "        CALCULATE ( MAX ( 'ECN Weeks'[Balance] ) )",
              "    )",
              ")"
            ],
            "lineageTag": "1908f801-dbd4-4863-9fa5-7d1162727577",
            "description": "Old-item balance at the end of the week; negative = short / running the new item.",
            "formatString": "#,0"
          }
        ]
      },
      {
        "name": "ECN Calendar",
        "lineageTag": "ce7d0c1b-4f02-4c02-8d7b-63c188c04b20",
        "description": "Last 12 weeks + this week (weekly charts).",
        "columns": [
          {
            "name": "Week Start",
            "dataType": "dateTime",
            "lineageTag": "28ed3a55-f158-47cb-a642-c8aa233a0b78",
            "summarizeBy": "none",
            "sourceColumn": "Week Start",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              },
              {
                "name": "UnderlyingDateTimeDataType",
                "value": "Date"
              }
            ],
            "formatString": "dd/MM/yyyy"
          },
          {
            "name": "Tuần",
            "dataType": "string",
            "lineageTag": "960617e4-16c7-4d00-911b-c22dbaab1216",
            "summarizeBy": "none",
            "sourceColumn": "Tuần",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "sortByColumn": "Week Start"
          },
          {
            "name": "Gần đây",
            "dataType": "string",
            "lineageTag": "eebfa8df-4af1-4aea-b90a-740ecee744cf",
            "summarizeBy": "none",
            "sourceColumn": "Gần đây",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "description": "Yes = last 13 weeks."
          }
        ],
        "partitions": [
          {
            "name": "ECN Calendar",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    // Last 25 weeks + this week, Monday first. \"Gần đây\" marks the last 13 weeks.",
                "    Monday = Date.StartOfWeek(TodayDate, Day.Monday),",
                "    Starts = List.Transform(List.Numbers(-25, 26), each Date.AddDays(Monday, _ * 7)),",
                "    T0     = Table.FromColumns({Starts}, {\"Week Start\"}),",
                "    Typed  = Table.TransformColumnTypes(T0, {{\"Week Start\", type date}}),",
                "    Lbl    = Table.AddColumn(",
                "                 Typed, \"Tuần\",",
                "                 each \"W\" & Text.PadStart(Text.From(fnIsoWeek([Week Start])), 2, \"0\"),",
                "                 type text),",
                "    Recent = Table.AddColumn(",
                "                 Lbl, \"Gần đây\",",
                "                 each if Duration.Days([Week Start] - Monday) >= -84 then \"Yes\" else \"No\",",
                "                 type text)",
                "in",
                "    Recent"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      }
    ],
