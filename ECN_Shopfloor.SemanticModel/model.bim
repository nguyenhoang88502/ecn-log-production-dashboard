          {
            "name": "Loại sự kiện",
            "dataType": "string",
            "lineageTag": "908f8ee8-3d52-4d4d-8b6f-00cbbe1423dd",
            "summarizeBy": "none",
            "sourceColumn": "Loại sự kiện",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "description": "Dời lịch = line has Wxx/week xx AND change; otherwise Khác."
          },
          {
            "name": "Dời sang",
            "dataType": "string",
            "lineageTag": "d2f12eeb-0319-4722-bbc8-a226394aff96",
            "summarizeBy": "none",
            "sourceColumn": "Dời sang",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "description": "Week the line moves the schedule to."
          }
        ],
        "partitions": [
          {
            "name": "ECN Notes",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"ECN Notes Base\",",
                "    AddWhen =",
                "        Table.AddColumn(",
                "            Source, \"Cập nhật\",",
                "            each if [DateFrom] <> null then Date.ToText([DateFrom], \"dd/MM\")",
                "                 else if [WkFrom] <> null then \"W\" & Text.From([WkFrom])",
                "                 else null,",
                "            type text",
                "        ),",
                "    AddDue =",
                "        Table.AddColumn(",
                "            AddWhen, \"Hạn / Est\",",
                "            each Text.Combine(",
                "                     List.Select(",
                "                         {",
                "                             if [FinishBy] <> null then \"Xong trước \" & Date.ToText([FinishBy], \"dd/MM/yyyy\") else null,",
                "                             if [EstWk] <> null then \"Est W\" & Text.From([EstWk])",
                "                             else if [EstTxt] <> null then \"Est \" & [EstTxt] else null,",
                "                             if [Target] <> null then \"Kế hoạch W\" & Text.From([Target]) else null,",
                "                             if [LastOrder] <> null then \"Đơn cuối \" & [LastOrder] else null",
                "                         },",
                "                         each _ <> null",
                "                     ),",
                "                     \" · \"",
                "                 ),",
                "            type text",
                "        ),",
                "    AddStock =",
                "        Table.AddColumn(",
                "            AddDue, \"Tồn cần xả\",",
                "            each if [Stock] = \"\" then null",
                "                 else \"Xả tồn \" & [Stock] & (if [Qty] <> null then \" · \" & [Qty] & \" pcs\" else \"\"),",
                "            type text",
                "        ),",
                "    AddKind =",
                "        Table.AddColumn(",
                "            AddStock, \"Loại sự kiện\",",
                "            each if [IsMove] = true then \"Dời lịch\" else \"Khác\",",
                "            type text",
                "        ),",
                "    Pick =",
                "        Table.SelectColumns(",
                "            AddKind,",
                "            {\"ECN Number\", \"Seq\", \"Line\", \"Text\", \"Cập nhật\", \"Who\", \"Vendor\", \"Category\",",
                "             \"Hạn / Est\", \"Tồn cần xả\", \"Key\", \"Loại sự kiện\", \"MoveTxt\"}",
                "        ),",
                "    Renamed = Table.RenameColumns(Pick, {{\"Who\", \"Người phụ trách\"}, {\"Vendor\", \"NCC\"},",
                "                                         {\"Category\", \"Phân loại\"}, {\"Text\", \"Nội dung\"},",
                "                                         {\"MoveTxt\", \"Dời sang\"}})",
                "in",
                "    Renamed"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "measures": [
          {
            "name": "Dòng ghi chú",
            "expression": [
              "COUNTROWS ( 'ECN Notes' )"
            ],
            "lineageTag": "da814709-f481-44da-97b4-db1448e73476",
            "description": "Parsed note lines.",
            "formatString": "#,0"
          },
          {
            "name": "Dòng chưa nhận dạng",
            "expression": [
              "CALCULATE ( COUNTROWS ( 'ECN Notes' ), 'ECN Notes'[Phân loại] = \"Chưa nhận dạng\" ) + 0"
            ],
            "lineageTag": "2b5b1b1b-910c-43be-9eb6-d51a34939543",
            "description": "Note lines no rule recognised - rewrite them following the entry rules.",
            "formatString": "#,0"
          },
          {
            "name": "Dòng dời lịch",
            "expression": [
              "CALCULATE ( COUNTROWS ( 'ECN Notes' ), 'ECN Notes'[Loại sự kiện] = \"Dời lịch\" ) + 0"
            ],
            "lineageTag": "52ba6eef-6c36-4907-8d25-4280302a1cd4",
            "description": "Note lines that move the schedule.",
            "formatString": "#,0"
          },
          {
            "name": "ECN có dời lịch",
            "expression": [
              "CALCULATE (",
              "    DISTINCTCOUNT ( 'ECN Notes'[ECN Number] ),",
              "    'ECN Notes'[Loại sự kiện] = \"Dời lịch\"",
              ") + 0"
            ],
            "lineageTag": "d7d5608c-c262-4067-90e0-0cc80efaa2eb",
            "description": "ECNs with at least one schedule move.",
            "formatString": "#,0"
          },
          {
            "name": "Event Fill",
            "expression": [
              "IF ( SELECTEDVALUE ( 'ECN Notes'[Loại sự kiện] ) = \"Dời lịch\", \"#FFE3A3\", \"#FFFFFF\" )"
            ],
            "lineageTag": "aee16eec-d100-49d5-9d20-658f1d87d35a",
            "description": "Cell colour for schedule-move lines."
          },
          {
            "name": "Dòng đã nhận dạng %",
            "expression": [
              "DIVIDE ( [Dòng ghi chú] - [Dòng chưa nhận dạng], [Dòng ghi chú] )"
            ],
            "lineageTag": "9fb6e21c-c430-4459-9507-1dbb7c6dbadd",
            "description": "Share of note lines the parser understood.",
            "formatString": "0%"
          }
        ]
      },
      {
        "name": "ECN Models",
        "lineageTag": "3e03c21b-5765-4419-9c72-e58908e0ec16",
        "description": "Bridge: ECN Number x model token of Model / Customer No.",
        "columns": [
          {
            "name": "ECN Number",
            "dataType": "string",
            "lineageTag": "e13d4013-920d-4dd0-9738-0189f907ce05",
            "summarizeBy": "none",
            "sourceColumn": "ECN Number",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "Model",
            "dataType": "string",
            "lineageTag": "3b9977de-c0f2-4082-994d-1bab500f76e9",
            "summarizeBy": "none",
            "sourceColumn": "Model",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "ECN Models",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Rows  = Table.SelectColumns(#\"ECN Base\", {\"ECN Number\", \"Model / Customer No.\"}),",
                "    Split = Table.AddColumn(Rows, \"Model\", each fnSplitList([#\"Model / Customer No.\"])),",
                "    Flat  = Table.ExpandListColumn(Split, \"Model\"),",
                "    Pick  = Table.SelectRows(Table.SelectColumns(Flat, {\"ECN Number\", \"Model\"}), each [Model] <> null),",
                "    Out   = Table.TransformColumnTypes(Table.Distinct(Pick), {{\"ECN Number\", type text}, {\"Model\", type text}})",
                "in",
                "    Out"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
      {
        "name": "ECN FG",
        "lineageTag": "df0cafdf-f0af-4b1d-93a1-5807e62ee76b",
        "description": "Bridge: ECN Number x FG code token.",
        "columns": [
          {
            "name": "ECN Number",
            "dataType": "string",
            "lineageTag": "46bfe799-4eb3-49d5-8e25-9ae48cd9fe81",
            "summarizeBy": "none",
            "sourceColumn": "ECN Number",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "FG Code",
            "dataType": "string",
            "lineageTag": "b53f8f23-9d81-4607-82cc-24ed2b22aa5f",
            "summarizeBy": "none",
            "sourceColumn": "FG Code",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "FG / ECN",
            "dataType": "string",
            "lineageTag": "d2e59a00-2987-42f5-909a-33c139a4bc36",
            "summarizeBy": "none",
            "sourceColumn": "FG / ECN",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "description": "Search box: type an FG code, pick the ECN."
          }
        ],
        "partitions": [
          {
            "name": "ECN FG",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Rows  = Table.SelectColumns(#\"ECN Base\", {\"ECN Number\", \"FG\"}),",
                "    Split = Table.AddColumn(Rows, \"FG Code\", each fnSplitList([FG])),",
                "    Flat  = Table.ExpandListColumn(Split, \"FG Code\"),",
                "    Pick  = Table.SelectRows(Table.SelectColumns(Flat, {\"ECN Number\", \"FG Code\"}), each [FG Code] <> null),",
                "    // ECNs with no FG still get one row so they can be found",
                "    NoFg  = List.Difference(List.Distinct(Rows[ECN Number]), List.Distinct(Pick[ECN Number])),",
                "    All   = Table.Combine({Pick, Table.FromRows(List.Transform(NoFg, each {_, \"—\"}), {\"ECN Number\", \"FG Code\"})}),",
                "    Find  = Table.AddColumn(Table.Distinct(All), \"FG / ECN\", each [FG Code] & \"  ·  \" & [ECN Number], type text),",
                "    Out   = Table.TransformColumnTypes(Find, {{\"ECN Number\", type text}, {\"FG Code\", type text}})",
                "in",
                "    Out"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
